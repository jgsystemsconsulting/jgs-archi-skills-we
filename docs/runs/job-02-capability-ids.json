      {
        "id": "id-9c2c1a6a78f0475681b48889b2664099",
        "name": "Promise",
        "type": "Capability",
        "layer": "Strategy",
        "documentation": "Evidence: stated - View Plan Job 02 approved; plant-brief.md sales-to-mill chain\nOrganisational ability to commit a plate date to a customer before mill work is locked. Sales-facing; OrderSight remains the sales-facing system for this capability (wording only, not modelled as an application here)."
      },
      {
        "id": "id-f6c7c6a74874412ba24c60d318292ad2",
        "name": "Order",
        "type": "Capability",
        "layer": "Strategy",
        "documentation": "Evidence: stated - View Plan Job 02 approved; plant-brief.md sales-to-mill chain\nOrganisational ability to hold one customer order identity through sales and works-order handoff so promise and mill schedule talk about the same order. WorksERP stays works-order context; no ERP replacement."
      },
      {
        "id": "id-ed34ec1744a1458b9f7e1579932f2af6",
        "name": "Mill schedule",
        "type": "Capability",
        "layer": "Strategy",
        "documentation": "Evidence: stated - View Plan Job 02 approved; plant-brief.md Named as-is systems\nOrganisational ability to plan and run the mill week for plate orders. MillOS owns this capability as mill schedule system of record (ownership in documentation only; no application element on this view)."
      },
      {
        "id": "id-50f22633aea34b3b8536e05a14fda533",
        "name": "Collect",
        "type": "Capability",
        "layer": "Strategy",
        "documentation": "Evidence: stated - View Plan Job 02 approved; plant-brief.md sales-to-mill chain\nOrganisational ability to close the loop after mill work so sales and plant can see what left the mill against the same order identity used at promise."
      }
    ],
