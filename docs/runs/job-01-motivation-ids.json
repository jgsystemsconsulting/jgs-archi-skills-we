  "view_contents": {
    "viewId": "id-05f18c92556242fc8ce2a2252fc36867",
    "viewName": "Motivation Overview",
    "viewpoint": "motivation",
    "elements": [
      {
        "id": "id-0260a5aa995b41c7b84d93d3541592c0",
        "name": "Plant Manager",
        "type": "Stakeholder",
        "layer": "Motivation",
        "documentation": "Evidence: stated - plant-brief.md Roles; View Plan Stakeholders\nOwns plant operations at Hatherley Works. Needs a weekly on-mill answer without reading PromiseSheet, and keeps mill systems under plant control."
      },
      {
        "id": "id-988afa0e45894cd3a657ac9c7085ed98",
        "name": "Head of Sales",
        "type": "Stakeholder",
        "layer": "Motivation",
        "documentation": "Evidence: stated - plant-brief.md Roles; View Plan Stakeholders\nOwns customer promises. Needs the same weekly on-mill answer as the plant so dual tracking in PromiseSheet can stop."
      },
      {
        "id": "id-db0cfaa61b4048e7900b2b9bad3eea97",
        "name": "MES Owner",
        "type": "Stakeholder",
        "layer": "Motivation",
        "documentation": "Evidence: stated - plant-brief.md Roles; View Plan Stakeholders\nOwns MillOS as mill schedule system of record. Boundary witness that OrderSight must not be drawn as MillOS replacement."
      },
      {
        "id": "id-92664a6b007b411d979d63c25480a38c",
        "name": "CRM Programme Manager",
        "type": "Stakeholder",
        "layer": "Motivation",
        "documentation": "Evidence: stated - plant-brief.md Roles; View Plan Stakeholders\nOwns OrderSight pilot scope. Keeps the funded fix sales-facing visibility; resists expansion into mill rewrite."
      },
      {
        "id": "id-ee9aa7f5d13c4ec9ba9da957d3768ed2",
        "name": "Operations Planner",
        "type": "Stakeholder",
        "layer": "Motivation",
        "documentation": "Evidence: stated - plant-brief.md Roles; View Plan Stakeholders\nPlans mill work from orders. Needs one order identity from promise through schedule so plan and promise stop diverging."
      },
      {
        "id": "id-9fc4203ce6ac494fbe546220c92f44b9",
        "name": "Integration Lead",
        "type": "Stakeholder",
        "layer": "Motivation",
        "documentation": "Evidence: stated - plant-brief.md Roles; View Plan Stakeholders\nOwns cross-system identity and PlantGate boundary work. Shared identity without merging MillOS into OrderSight."
      },
      {
        "id": "id-fcf6a7e660504afaa4580a9a92e062d9",
        "name": "Promised plate dates do not match mill reality",
        "type": "Driver",
        "layer": "Motivation",
        "documentation": "Evidence: stated - plant-brief.md Motivation spine; View Plan Technical Hints\nSales tracks customer promises in PromiseSheet while the mill schedule lives in MillOS, so promised plate dates drift from what the mill can actually run."
      },
      {
        "id": "id-77f9fed68144498386bf15c188fc2d21",
        "name": "Sales and mill share one order identity from promise to schedule",
        "type": "Goal",
        "layer": "Motivation",
        "documentation": "Evidence: stated - plant-brief.md Motivation spine; View Plan Technical Hints\nDesired state: one shared order identity links sales promise to mill schedule end to end, without merging systems into a single blob."
      },
      {
        "id": "id-bbf70387a3014a0bac693ecca4cce026",
        "name": "Plant Manager and Head of Sales answer on-mill-this-week without PromiseSheet",
        "type": "Outcome",
        "layer": "Motivation",
        "documentation": "Evidence: stated - plant-brief.md Motivation spine; View Plan Technical Hints\nPlant Manager and Head of Sales can answer whether an order is on the mill this week without opening PromiseSheet."
      },
      {
        "id": "id-8387c0d7776b46b8a08ee1ad05bd0953",
        "name": "OrderSight must not swallow MillOS",
        "type": "Requirement",
        "layer": "Motivation",
        "documentation": "Evidence: stated - plant-brief.md Motivation spine and Hard freeze; View Plan Technical Hints\nHard boundary: OrderSight stays sales-facing visibility; MillOS remains the mill schedule system of record. Named systems appear here as wording only, not as application elements on this view."
      }
    ],
